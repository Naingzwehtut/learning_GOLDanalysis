# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/

# Pytest
.pytest_cache/

# Data (kept out of version control - regenerate via scripts)
data/raw/*.csv
data/processed/*.csv
!data/raw/.gitkeep
!data/processed/.gitkeep

# Reports (generated artifacts)
reports/*.txt
reports/*.md
reports/*.html
!reports/.gitkeep

# OS / editor
.DS_Store
.vscode/
.idea/

# Environment variables
.env
